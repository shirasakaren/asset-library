# Static preview build — everything is optional; defaults are shown.
# Only NEXT_PUBLIC_* values are read (inlined at build time).

NEXT_PUBLIC_APP_NAME="MGM Asset Library"
NEXT_PUBLIC_APP_URL=https://asset.creations.ren

NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,id

# Serve from a sub-path, e.g. /asset-library for the GitHub project Pages URL
# (https://shirasakaren.github.io/asset-library/). Leave empty for a domain root
# (custom domain). Inlined at build time; no trailing slash. pages.yml sets it from
# the repository's Pages settings.
NEXT_PUBLIC_BASE_PATH=

# Community external links (Navbar > Community dropdown). Blank = "Coming soon".
NEXT_PUBLIC_COMMUNITY_DOCS_URL=
NEXT_PUBLIC_COMMUNITY_LEARNING_URL=
NEXT_PUBLIC_COMMUNITY_HELP_URL=

# Set to 1 to add a small artificial latency to the in-browser mock API.
NEXT_PUBLIC_PREVIEW_LATENCY=

# OpenAPI generation source (only for `pnpm openapi:gen`). Defaults to ../backend/openapi.json
OPENAPI_SOURCE=
